# =====================================================================
# Configuration du backend E-TaxeColis
# Modifiez les valeurs après le signe =, sans espaces autour.
# =====================================================================

# ----- Base de données PostgreSQL -----
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=miorapost12
DB_NAME=taxation
DB_PORT=5432

# ----- Serveur Express -----
PORT=8082

# ----- Connexion (jeton JWT) -----
# Une longue phrase secrète (changez-la ; ne la donnez à personne)
JWT_SECRET=E-TaxeColis_cle_secrete_a_changer_2026_x9Qm4LzT
# Durée d'une connexion avant de devoir se reconnecter (ex: 8h, 1d)
JWT_DUREE=8h

# ----- Compte administrateur (utilisé par : npm run creer-admin) -----
ADMIN_NOM=Administrateur
ADMIN_EMAIL=admin@etaxecolis.mg
ADMIN_MOTPASSE=Admin@2026

# ----- Envoi des emails -----
# Laissez SMTP_USER vide pour le MODE TEST : les emails s'affichent dans le terminal.
# Avec Gmail : SMTP_USER = votre adresse Gmail, SMTP_PASS = un "mot de passe d'application"
# (voir GUIDE.md, partie Email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_EXPEDITEUR=E-TaxeColis <votre.adresse@gmail.com>

# Adresse du frontend (sert pour le lien "Accéder à l'application" dans l'email)
URL_FRONTEND=http://localhost:5173
